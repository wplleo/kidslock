<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础深色主题 -->
    <style name="Theme.KidsLock" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/highlight</item>
        <item name="android:windowBackground">@color/settings_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- 锁屏全屏主题 -->
    <style name="Theme.KidsLock.FullScreen" parent="Theme.KidsLock">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
